# URL do PostgreSQL hospedado. Para Render + Supabase, use Connect > Session pooler.
# Copie a URL gerada pelo painel; não invente o host nem o usuário.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:5432/postgres?sslmode=require

# Gere um valor aleatório longo. Não reutilize esta chave em outros projetos.
SESSION_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA

# Porta HTTP da API/interface.
PORT=3000

# Para deploy no Render (HTTPS), defina true. Em desenvolvimento local HTTP, use false.
COOKIE_SECURE=false

# Quantidade máxima de conexões PostgreSQL abertas pela aplicação.
DB_POOL_MAX=5
